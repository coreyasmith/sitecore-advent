---
import BaseHead from "@/components/BaseHead.astro";
import SnowScene from "@/components/SnowScene.astro";
import SnowToggle from "@/components/SnowToggle.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";
import { CALENDAR_YEARS } from "@/utils/calendar";

// `year` is the calendar the page belongs to; the header's year menu shows it
const { title, description, image, enableSnowfall = true, year } = Astro.props;

// The page wears its year's theme (see global.css); a page outside any year wears the newest's
const theme = year ?? CALENDAR_YEARS[0];

// 2026's snow piles up in a snowbank with a snowball fight on top; other years' just falls
const snowbank = enableSnowfall && theme === 2026;
---

<html lang="en" data-theme={theme}>
<head>
  <BaseHead title={title} description={description} image={image} />
</head>
<body class="text-white min-h-screen flex flex-col">
  {enableSnowfall && <SnowScene snowbank={snowbank} />}
  <Header year={year}>
    {enableSnowfall && <SnowToggle slot="actions" />}
  </Header>

  <main class="grow p-6 max-w-6xl mx-auto w-full">
    <slot />
  </main>

  <Analytics />
  <Footer />
</body>
</html>
