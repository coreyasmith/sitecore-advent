---
// A small calendar in a year's site theme: a page in a frame, a band and binder rings,
// and six doors. Like the real calendar, a door lights up in the year's colors once
// that day's post is live and stays gray until then, so a year that hasn't started is
// all gray. The year menu uses it on its pill and next to each year in its list.
import { getIconColors, getIconTheme } from '@/utils/calendar';

interface Props {
  year: number;
  /** How many of the year's doors are open (its live posts) */
  open: number;
  class?: string;
}

const { year, open, class: className } = Astro.props;
const theme = getIconTheme(year);
const doorFills = getIconColors(year).map((color, i) => (i < open ? color : theme.lockedDoor));
const doorSpots = [[5, 11.25], [10.25, 11.25], [15.5, 11.25], [5, 16.25], [10.25, 16.25], [15.5, 16.25]];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} aria-hidden="true">
  <rect x="2.5" y="4" width="19" height="17.5" rx="3" fill={theme.page} stroke={theme.frame} stroke-width="1.6" />
  <path d="M2.5 7a3 3 0 0 1 3-3h13a3 3 0 0 1 3 3v2.5h-19z" fill={theme.band} />
  <rect x="6.5" y="2" width="2" height="4.5" rx="1" fill={theme.rings} />
  <rect x="15.5" y="2" width="2" height="4.5" rx="1" fill={theme.rings} />
  {doorSpots.map(([x, y], i) => <rect x={x} y={y} width="3.5" height="3.5" rx="0.8" fill={doorFills[i]} />)}
</svg>
