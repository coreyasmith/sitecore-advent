---
// Snow falling over the page. On the 2026 theme it piles up in a snowbank with a snowball fight
// on top (see src/scripts/snow/snow-scene.ts).
interface Props {
  /** Pile the snow up in a snowbank along the bottom of the window, with a snowball fight on top */
  snowbank?: boolean;
}

const { snowbank = false } = Astro.props;
---

<script>
  import '@/scripts/snow/snow-scene';
</script>
<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
  }
  /* With the snow off there's no snowbank to keep focused items clear of (see Layout) */
  :global(html[data-snow-off]) {
    scroll-padding-bottom: 0;
  }
  /* Not on paper: pinned to the window, the scene would print over the bottom of every page */
  @media print {
    snow-scene {
      display: none;
    }
  }
</style>
<snow-scene data-snowbank={snowbank || undefined} data-keep-clear={snowbank ? 'footer button' : undefined} aria-hidden="true">
  <canvas></canvas>
</snow-scene>
