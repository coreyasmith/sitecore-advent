---
// Google Analytics, behind a cookie banner. It only loads where the build has
// PUBLIC_GOOGLE_ANALYTICS_ID (set for Production in the Cloudflare Pages project), and only
// after the visitor accepts; until then nothing goes to Google. Without it (previews, astro dev) the
// banner still shows, but nothing is ever sent. The choice is kept in localStorage, and
// "Cookie settings" in the footer brings the banner back to change it. ClientRouter changes
// pages without reloading them, so a page view is sent on each page load. The link under the
// question is the page Google Analytics' policies suggest linking to.
//
// The banner sits in the bottom-left corner of the window. It goes just before the footer
// (see Layout) in a sticky, zero-height strip, so once the footer scrolls into view the banner
// rides on top of it instead of covering it. z-9999, the same as the snow but later in the
// page, keeps it above the snow.
---

<div class="sticky bottom-0 z-9999 h-0">
  <section
    id="cookie-consent"
    aria-labelledby="cookie-consent-title"
    hidden
    transition:persist
    class="absolute inset-x-4 bottom-4 rounded-2xl bg-surface/95 p-5 shadow-2xl ring-1 ring-accent/40 backdrop-blur sm:right-auto sm:w-84"
  >
    <h2 id="cookie-consent-title" class="font-logo text-lg font-extrabold"><span aria-hidden="true">🍪</span> Fancy a cookie?</h2>
    <p class="mt-1 text-sm text-pretty">May we use Google Analytics cookies to count visits and see which posts get read?</p>
    <a href="https://policies.google.com/technologies/partner-sites" class="mt-2 inline-block text-xs text-white/70 underline hover:text-white">How Google uses this data</a>
    <div class="mt-3 flex gap-2">
      {[['denied', 'Decline'], ['granted', 'Accept']].map(([consent, label]) => (
        <button
          type="button"
          data-consent={consent}
          class="flex-1 rounded-full bg-[#fde68a] px-4 py-1.5 text-sm font-bold text-surface hover:brightness-110 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          {label}
        </button>
      ))}
    </div>
  </section>
</div>

<script>
  declare global {
    interface Window {
      dataLayer: unknown[];
      gtag: (...args: unknown[]) => void;
    }
  }

  const ID: string | undefined = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;
  const KEY = 'analytics-consent';

  // Only these two count as a choice; anything else stored under the key asks again
  const valid = (value: string | null) => (value === 'granted' || value === 'denied' ? value : null);

  let choice: string | null = null;
  try {
    choice = valid(localStorage.getItem(KEY));
  } catch {}
  let loaded = false;
  let lastPage = '';

  function track() {
    if (!ID || choice !== 'granted' || location.href === lastPage) return;
    if (!loaded) {
      loaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      // Page views are sent by hand below. For this tag, send_page_view: false in config
      // alone doesn't stop its own; setting it first does.
      window.gtag('set', { send_page_view: false });
      window.gtag('js', new Date());
      window.gtag('config', ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${ID}`;
      document.head.append(script);
    }
    window.gtag('event', 'page_view', {
      page_location: location.href,
      page_title: document.title,
      page_referrer: lastPage || document.referrer,
    });
    lastPage = location.href;
  }

  function onPage() {
    const banner = document.getElementById('cookie-consent');
    if (banner) banner.hidden = choice !== null;
    track();
  }

  // A new choice, made in this tab or another one
  function setChoice(value: string | null) {
    choice = value;
    // Declining after accepting turns Google Analytics off at once and removes its cookies
    if (loaded) (window as unknown as Record<string, boolean>)[`ga-disable-${ID}`] = choice !== 'granted';
    if (ID && choice === 'denied') {
      // Google sets them on the whole site: scadvent.com for www.scadvent.com
      const domain = location.hostname.replace(/^www\./, '');
      for (const name of ['_ga', `_ga_${ID.slice(2)}`]) document.cookie = `${name}=; Max-Age=0; path=/; domain=.${domain}`;
    }
    onPage();
  }

  onPage();
  document.addEventListener('astro:page-load', onPage);
  window.addEventListener('storage', (event) => {
    if (event.key === KEY) setChoice(valid(event.newValue));
  });
  let opener: HTMLElement | null = null;
  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    // "Cookie settings" in the footer brings the banner back, to change the choice either way
    const settings = target.closest<HTMLElement>('[data-cookie-settings]');
    const banner = document.getElementById('cookie-consent');
    if (settings && banner) {
      opener = settings;
      banner.hidden = false;
      banner.querySelector('button')?.focus();
      return;
    }
    const button = target.closest<HTMLElement>('#cookie-consent [data-consent]');
    if (!button) return;
    const value = button.dataset.consent!;
    try {
      localStorage.setItem(KEY, value);
    } catch {}
    setChoice(value);
    // Back to "Cookie settings" if that's where the banner was opened, even on an earlier page
    if (opener) (opener.isConnected ? opener : document.querySelector<HTMLElement>('[data-cookie-settings]'))?.focus();
    opener = null;
  });
</script>
